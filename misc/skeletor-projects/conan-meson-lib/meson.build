project('__PROJECT-NAME__', 'c', 'cpp',
  version: '1.0.0',
  license: 'MIT',
  default_options: ['warning_level=2', 'cpp_std=c++20'])

project_name = '__PROJECT-NAME__'
test_project_name = project_name + '_tests'
lib_name = project_name

deps = [
  dependency('sqlite3'),
  dependency('spdlog'),
  dependency('doctest'),
]

inc = include_directories('include')

subdir('include')
subdir('src')
subdir('test')

pkg_mod = import('pkgconfig')
pkg_mod.generate(
  libraries: main_lib,
  version: '1.0',
  name: 'lib' + lib_name,
  filebase: lib_name,
  description: 'A sample library generated by skeletor.')
